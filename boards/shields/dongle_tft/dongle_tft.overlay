/*
 * ST7789V 240x240 TFT on an nRF52840 Pro Micro board (nice!nano and clones):
 * keyboard status on the top half, host system monitor on the bottom half.
 *
 * Pin choice follows the Snake Dongle (github.com/joaopedropio/snake-dongle),
 * so the enclosures built for it fit. Pro Micro pads in the third column:
 *
 *   SCK  P0.17  D2      DC   P0.24  D5
 *   MOSI P0.20  D3      RST  P0.22  D4
 *   CS   P0.11  D7      BL   P1.04  D8   (PWM1 channel 1)
 *
 * The README's wiring table is generated from these numbers — keep the two
 * in step if you re-pin anything.
 *
 * SPDX-License-Identifier: MIT
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * i2c0 (pro_micro_i2c) is TWIM0, the same peripheral instance as SPIM0, and it
 * defaults to SDA P0.17 / SCL P0.20 — exactly our SCK and MOSI. It is off by
 * default on this board and disabled again here to say so out loud: this
 * shield cannot be combined with one that needs the Pro Micro I2C bus, such
 * as an SSD1306 OLED shield.
 */
&i2c0 {
    status = "disabled";
};

/ {
    chosen {
        zephyr,display = &st7789;
        /*
         * ZMK switches this on at startup and off again only when it blanks
         * the display, which dongle_tft.conf disables. Nothing sets a
         * brightness, so the backlight is simply on; pwm-leds is used rather
         * than gpio-leds only to leave led_set_brightness() available.
         */
        zmk,display-led = &pwm_led_0;
    };

    lcd_backlight: lcd_backlight {
        compatible = "pwm-leds";

        pwm_led_0: pwm_led_0 {
            pwms = <&pwm1 1 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>, <NRF_PSEL(SPIM_MOSI, 0, 20)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>, <NRF_PSEL(SPIM_MOSI, 0, 20)>;
            low-power-enable;
        };
    };

    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT1, 1, 4)>;
        };
    };

    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT1, 1, 4)>;
            low-power-enable;
        };
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
};

/ {
    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi0>;
        dc-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789: st7789v@0 {
            compatible = "sitronix,st7789v";
            mipi-max-frequency = <30000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            reg = <0>;
            width = <240>;
            height = <240>;
            x-offset = <0>;
            y-offset = <0>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x05>;
            lcm = <0x2c>;
            porch-param = [ 0c 0c 00 33 33  ];
            cmd2en-param = [ 5a 69 02 01  ];
            pwctrl1-param = [ a4 a1  ];
            pvgam-param = [ D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23  ];
            nvgam-param = [ D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23  ];
            ram-param = [ 00 F0  ];
            rgb-param = [ CD 08 14  ];
        };
    };
};

/*
 * Second USB function next to the HID interfaces: the plain serial port the
 * Mac daemon (host/sysmon-daemon) pushes metrics into. The daemon finds it by
 * handshake, so its index among the CDC interfaces does not matter.
 */
&zephyr_udc0 {
    sysmon_uart: sysmon_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};
